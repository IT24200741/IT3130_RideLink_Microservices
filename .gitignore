# ===============================================
# RideLink IT3130 - Java Spring Boot .gitignore
# ===============================================

# Compiled Java files
target/
*.class
*.jar
*.war
*.ear
*.nar

# Maven Wrapper Exception
!.mvn/wrapper/maven-wrapper.jar

# Logs & Databases
logs/
*.log
*.sqlite
*.sqlite3
*.db
*.trace.db

# Environment & Secrets (NEVER COMMIT SECRETS)
.env
.env.local
*.pem
*.key

# IDE & Editor files
.vscode/
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini
